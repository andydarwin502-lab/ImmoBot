# ------------------------------------------------------------------
# FICHIER D'EXEMPLE — pour TESTER EN LOCAL sur ton PC.
# Copie ce fichier en ".env" (juste ".env", sans le ".example")
# et remplis tes vraies valeurs. Le fichier ".env" est ignoré par git,
# donc tes secrets ne partiront jamais sur GitHub.
#
# ⚠️ Sur GitHub, on n'utilise PAS ce fichier : on met ces 4 valeurs
#    dans "Settings > Secrets and variables > Actions" (voir TUTO.md).
# ------------------------------------------------------------------

# L'adresse Gmail dédiée qui reçoit les alertes des sites immo
GMAIL_USER=ton.adresse.dediee@gmail.com

# Le "mot de passe d'application" Gmail (16 caractères, PAS ton mot de passe habituel)
# Voir TUTO.md, étape 1.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# La clé API Gemini (gratuite, Google AI Studio) — voir TUTO.md, étape 4.
GEMINI_API_KEY=AIza...

# L'URL du webhook Discord — voir TUTO.md, étape 3.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/....../......

# Optionnel : modèle Gemini (laisse tel quel si tu ne sais pas)
GEMINI_MODEL=gemini-2.0-flash
